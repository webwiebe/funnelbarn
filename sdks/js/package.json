{
  "name": "@funnelbarn/js",
  "version": "1.0.0",
  "description": "Browser + Node.js SDK for FunnelBarn analytics",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run build:iife",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:iife": "rollup -c rollup.iife.config.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "pnpm run build && node --test test/sdk.test.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^22.0.0",
    "rollup": "^4.0.0",
    "tslib": "^2.8.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "analytics",
    "funnelbarn",
    "self-hosted",
    "privacy"
  ],
  "license": "MIT",
  "homepage": "https://github.com/wiebe-xyz/funnelbarn",
  "dependencies": {
    "rrweb": "^2.0.1"
  }
}
