apiVersion: v1
kind: Secret
metadata:
  name: funnelbarn-secrets
  namespace: funnelbarn-production
type: Opaque
stringData:
  FUNNELBARN_API_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_ADMIN_USERNAME: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_ADMIN_PASSWORD_BCRYPT: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_SESSION_SECRET: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_SELF_ENDPOINT: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_SELF_API_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  # Cloudflare R2. One token serves both the session-recordings store and the
  # Litestream SQLite replica (bucket barn-backups); the deployment maps these
  # two keys onto LITESTREAM_ACCESS_KEY_ID / LITESTREAM_SECRET_ACCESS_KEY.
  FUNNELBARN_R2_ENDPOINT: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_R2_ACCESS_KEY_ID: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_R2_SECRET_ACCESS_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_R2_BUCKET: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  # IAMBarn login is gated by the "iambarn-enabled" feature flag in the dogfood project (FUNNELBARN_DOGFOOD_PROJECT)
