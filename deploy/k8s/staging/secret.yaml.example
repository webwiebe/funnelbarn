apiVersion: v1
kind: Secret
metadata:
  name: funnelbarn-secrets
  namespace: funnelbarn-staging
type: Opaque
stringData:
  FUNNELBARN_API_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_ADMIN_USERNAME: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_ADMIN_PASSWORD_BCRYPT: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_SESSION_SECRET: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_SELF_ENDPOINT: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  FUNNELBARN_SELF_API_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  # Shared Valkey command queue, ACL user funnelbarn (k3s-infra#68). Unset = in-process dispatcher.
  FUNNELBARN_REDIS_QUEUE_URL: REPLACE_WITH_SOPS_ENCRYPTED_VALUE  # redis://funnelbarn:<pw>@valkey-primary.shared-staging.svc:6379/0
  # IAMBarn login is gated by the "iambarn-enabled" feature flag in the dogfood project (FUNNELBARN_DOGFOOD_PROJECT)
  # Read only by the deploy pipeline (MCP resource registration); no container references it.
  # IAMBarn PAT with scope admin:clients:write, see deploy/SECRETS.md.
  IAMBARN_ADMIN_TOKEN: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
